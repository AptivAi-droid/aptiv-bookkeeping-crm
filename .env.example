# ============================================================
# Aptiv Bookkeeping CRM — Environment Variables
# Kenya Edition
# ============================================================
#
# SAFE FOR VITE_ (bundled into client — intentionally public):
#   VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are designed to be
#   public. Supabase RLS policies enforce all access control.
#
# SERVER-SIDE SECRETS (Supabase Vault only — NEVER use VITE_ prefix):
#   MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET, MPESA_PASSKEY, MPESA_SHORTCODE
#   MPESA_CALLBACK_URL, BRIDGE_API_KEY, BRIDGE_API_URL
#   → See: supabase/functions/mpesa-proxy/ and supabase/functions/bridge-proxy/
#   → Set with: supabase secrets set KEY=value
# ============================================================

# ── Supabase (safe to expose) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── M-Pesa environment toggle (not a secret) ──────────────────────────────────
VITE_MPESA_ENV=sandbox

# ── Base path (for GitHub Pages subdirectory) ─────────────────────────────────
# Set to / when using a custom domain
VITE_BASE_PATH=/aptiv-bookkeeping-crm/

# ── SERVER-SIDE ONLY (set as Supabase secrets — DO NOT add VITE_ prefix) ──────
# These are accessed only by the Edge Functions, never by the browser.
#
# supabase secrets set MPESA_CONSUMER_KEY=your_daraja_consumer_key
# supabase secrets set MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# supabase secrets set MPESA_SHORTCODE=your_business_shortcode
# supabase secrets set MPESA_PASSKEY=your_lipa_na_mpesa_passkey
# supabase secrets set MPESA_CALLBACK_URL=https://yourdomain.com
# supabase secrets set MPESA_SECURITY_CREDENTIAL=your_b2c_security_credential
# supabase secrets set MPESA_ENV=production
#
# supabase secrets set BRIDGE_API_URL=https://your-bookkeeping-api.com
# supabase secrets set BRIDGE_API_KEY=your_api_key
